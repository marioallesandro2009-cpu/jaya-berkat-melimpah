APP_NAME="PT Jaya Berkat Melimpah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Zona waktu aplikasi = zona waktu jam yang tersimpan di database (created_at, dll).
# JANGAN diubah setelah ada data di database: data yang sudah tersimpan akan DITAFSIRKAN
# ULANG menurut zona waktu baru (bukan dikonversi), sehingga semua jam bergeser.
# Tampilan untuk pengguna (mis. "Diterima ... WIB") sudah dikonversi eksplisit ke Asia/Jakarta.
APP_TIMEZONE=UTC

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development cepat: sqlite. Produksi: ganti ke mysql dan aktifkan baris DB_* di bawah.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jbm
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Keamanan (opsional di lokal; nilai produksi ada di .env.production.example)
FORCE_HTTPS=false
HSTS_MAX_AGE=0
CSP_MODE=report-only
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONVERSIONS_BY_DEFAULT=false
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Konversi gambar WebP: auto | on | off (auto = aktif jika ekstensi GD/Imagick tersedia)
IMAGE_CONVERSIONS=auto

# Nomor WhatsApp awal untuk seeder Settings (boleh kosong; tombol WhatsApp disembunyikan jika kosong)
WHATSAPP_NUMBER=

# Panel admin. Di development seeder membuat admin dari ADMIN_EMAIL / ADMIN_PASSWORD bila password
# itu kuat (>= 12 karakter, huruf besar & kecil, angka, simbol) dan tidak pernah mengubah akun yang
# sudah ada. Di production pakai `php artisan admin:create`.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PATH=admin

# Cloudflare Turnstile (opsional; di APP_ENV=local selalu lolos). Kunci uji Cloudflare:
# site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Retensi data pribadi pada Pesan Masuk (form Kontak). Dijalankan harian oleh scheduler
# (`leads:prune`, butuh cron schedule:run, lihat DEPLOY.md A13). 0 = matikan langkah itu.
# - IP dan user-agent pengirim dihapus setelah sekian hari
# - seluruh pesan dihapus setelah sekian bulan
LEADS_ANONYMIZE_AFTER_DAYS=60
LEADS_DELETE_AFTER_MONTHS=12
# Automatic draft translations in the admin (EN -> ID): driver deepl, google or anthropic (Claude), plus its API key.
# Empty = the draft buttons only explain how to switch it on. Drafts are never shown on the site until someone marks them
# "Sudah dicek". The key stays in this file only; only the text being translated is sent to the service.
TRANSLATION_DRIVER=
TRANSLATION_API_KEY=
# anthropic only (optional): the Claude model, default claude-haiku-4-5-20251001
TRANSLATION_MODEL=
