# Template .env untuk PRODUKSI (shared hosting cPanel). Di server:
#     cp .env.production.example .env
# lalu isi nilai yang kosong / bertanda contoh (lihat DEPLOY.md bagian A5).
# Untuk development lokal pakai .env.example (`composer setup` menyalinnya otomatis).

APP_NAME="PT Jaya Berkat Melimpah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Deploy pertama: http:// (alamat gambar unggahan dibangun dari nilai ini; https:// sebelum SSL aktif
# membuat gambar rusak). Ubah ke https:// BERSAMAAN dengan FORCE_HTTPS=true, hanya setelah SSL terbukti jalan.
# Urutan lengkap: GO_LIVE_CHECKLIST.md
APP_URL=http://jbmelimpah.com

# Zona waktu aplikasi = zona waktu jam yang tersimpan di database (created_at, dll).
# JANGAN diubah setelah ada data di database: data yang sudah tersimpan akan DITAFSIRKAN
# ULANG menurut zona waktu baru (bukan dikonversi), sehingga semua jam bergeser.
# Tampilan untuk pengguna (mis. "Diterima ... WIB") sudah dikonversi eksplisit ke Asia/Jakarta.
APP_TIMEZONE=UTC

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Shared hosting cPanel: MySQL/MariaDB. Nama DB & user di cPanel berawalan prefix akun,
# contoh: ACCOUNT_jbm. Buat lewat cPanel > MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ACCOUNT_jbm
DB_USERNAME=ACCOUNT_jbm
DB_PASSWORD=

# Session/cache/queue tanpa proses yang harus jalan terus (tidak ada Redis / queue worker).
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie hanya lewat https. Dikosongkan = mengikuti FORCE_HTTPS (nyalakan FORCE_HTTPS setelah
# SSL aktif). Jangan di-set true sebelum SSL aktif: cookie tidak akan tersimpan, login dan form gagal (419).
# SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Keamanan (lihat SECURITY_AUDIT.md dan DEPLOY.md) ---------------------------------------
# Paksa https. Biarkan false sampai AutoSSL selesai (cPanel > SSL/TLS Status), lalu ubah ke
# true + config:cache. APP_URL harus diawali https:// agar ini bekerja.
FORCE_HTTPS=false
# HSTS (hanya dikirim lewat https). 0 = mati. Mulai kecil, naikkan bertahap setelah semua
# berjalan lewat https: 300 (5 menit) -> 86400 (1 hari) -> 2592000 (30 hari) -> 31536000.
HSTS_MAX_AGE=300
HSTS_INCLUDE_SUBDOMAINS=false
# Content-Security-Policy halaman publik: report-only (hanya catat di konsol browser) | enforce | off
CSP_MODE=report-only
# Proxy yang dipercaya agar IP asli pengunjung terbaca (rate limit form Kontak & login).
# Kosong = tidak ada (situs diakses langsung). Setelah Cloudflare aktif: cloudflare
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONVERSIONS_BY_DEFAULT=false
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email notifikasi leads dari form Kontak. WAJIB SMTP di produksi. Buat akun email di cPanel
# (Email Accounts), mis. noreply@jbmelimpah.com, lalu isi kredensialnya di bawah.
# From = MAIL_FROM_ADDRESS (hanya bisa diubah di sini, bukan dari admin). Penerima notifikasi
# diatur di admin: Pengaturan Situs > tab Kontak. Lihat DEPLOY.md bagian A10 (SPF/DKIM).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.jbmelimpah.com
MAIL_PORT=465
MAIL_USERNAME=noreply@jbmelimpah.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@jbmelimpah.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Konversi gambar WebP: auto | on | off (auto = aktif jika ekstensi GD/Imagick tersedia)
IMAGE_CONVERSIONS=auto

# Nomor WhatsApp awal untuk seeder Settings (boleh kosong; tombol WhatsApp disembunyikan jika kosong)
WHATSAPP_NUMBER=

# Panel admin. Akun admin pertama dibuat DI SERVER dengan `php artisan admin:create` (password
# diminta lewat input tersembunyi, tidak disimpan di .env); seeder tidak membuat admin di production.
# Alamat panel (default /admin). Mengubahnya hanya menyembunyikan alamat, bukan pengaman.
ADMIN_PATH=admin

# Cloudflare Turnstile (CAPTCHA) di form Kontak dan login admin. Mati secara default. Bila aktif,
# form Kontak butuh JavaScript. Buat widget di dash.cloudflare.com > Turnstile, isi kedua kunci.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Retensi data pribadi pada Pesan Masuk (form Kontak). Dijalankan harian oleh scheduler
# (`leads:prune`, butuh cron schedule:run, lihat DEPLOY.md A12). 0 = matikan langkah itu.
# - IP dan user-agent pengirim dihapus setelah sekian hari
# - seluruh pesan dihapus setelah sekian bulan
LEADS_ANONYMIZE_AFTER_DAYS=60
LEADS_DELETE_AFTER_MONTHS=12
# Automatic draft translations in the admin (EN -> ID): driver deepl, google or anthropic (Claude), plus its API key.
# Empty = the draft buttons only explain how to switch it on. Drafts are never shown on the site until someone marks them
# "Sudah dicek". The key stays in this file only; only the text being translated is sent to the service.
TRANSLATION_DRIVER=
TRANSLATION_API_KEY=
# anthropic only (optional): the Claude model, default claude-haiku-4-5-20251001
TRANSLATION_MODEL=
