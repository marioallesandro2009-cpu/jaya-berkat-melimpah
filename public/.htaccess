# Never serve hidden files (.env, .git, .htpasswd ...; .htaccess itself is never served by
# Apache), dependency manifests, logs, dumps or backups. The document root is meant to be
# ~/jbm/public so none of these exist here; this is the second line of defence if the
# symlink ever points one level too high. ".well-known" (AutoSSL) stays reachable.
<FilesMatch "^\.(?!well-known$)">
    Require all denied
</FilesMatch>
<FilesMatch "(^(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml(\.dist)?|vite\.config\.js|\.env.*)$|\.(log|sql|sqlite[0-9]?|bak|old|orig|swp|dist|md|yml|yaml|ini)$)">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # https and the canonical host (www or non-www) are NOT decided here: .htaccess cannot
    # read .env, and forcing https before SSL is installed would make the site unreachable.
    # They follow APP_URL and FORCE_HTTPS via the EnforceCanonicalHost middleware.

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/ld+json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/webp .webp
</IfModule>

# Browser caching: versioned css/js/fonts for 1 year (see the headers below), images for 30 days.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    # css/js are requested with ?v=<file mtime>, so a changed file gets a new URL: cache them for good.
    <If "%{REQUEST_URI} =~ m#^/(css|js|fonts)/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <If "%{REQUEST_URI} =~ m#^/storage/#">
        Header set Cache-Control "public, max-age=2592000"
    </If>
    # An SVG opened directly (not via <img>) must never run script: logo/favicon SVGs
    # uploaded in the admin are stored as-is, so they are served in a locked-down sandbox.
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
